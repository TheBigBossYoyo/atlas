{
  "name": "atlas",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Atlas"
  },
  "description": "Universal document viewer for Windows",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-extension-manifest.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "generate:extensions": "node scripts/generate-extension-manifest.mjs",
    "generate:templates": "node scripts/generate-templates.mjs",
    "icon": "node scripts/build-icon.mjs",
    "preelectron:build": "npm run icon",
    "lint": "eslint src electron tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:preview": "npm run build && electron ."
  },
  "overrides": {
    "@glideapps/glide-data-grid": {
      "react": "$react",
      "react-dom": "$react-dom",
      "marked": "$marked"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@glideapps/glide-data-grid": "^6.0.3",
    "codemirror": "^6.0.2",
    "docx": "^9.6.1",
    "dompurify": "^3.4.15",
    "fast-xml-parser": "^5.8.0",
    "html2canvas-pro": "^2.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.3",
    "mermaid": "^11.17.2",
    "odf-kit": "0.13.4",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-responsive-carousel": "^3.2.23",
    "react-window": "^2.2.7",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rtf.js": "^3.0.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.1.2",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.6",
    "wait-on": "^8.0.3"
  }
}
