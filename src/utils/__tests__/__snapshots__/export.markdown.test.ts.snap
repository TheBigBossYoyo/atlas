\\int_0^\\infty e^{-x^2} </w:t></w:r><w:r><w:t xml:space="preserve">\\,</w:t></w:r><w:r><w:t xml:space="preserve"> dx = \\frac{\\sqrt{\\pi}}{2}
$$</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11906" w:h="16838" w:orient="portrait"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:pgNumType/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>"
