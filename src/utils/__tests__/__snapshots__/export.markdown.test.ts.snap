e w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Team Roster</w:t></w:r></w:p><w:p/><w:tbl><w:tblPr><w:tblW w:type="auto" w:w="100"/><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4"/><w:left w:val="single" w:color="auto" w:sz="4"/><w:bottom w:val="single" w:color="auto" w:sz="4"/><w:right w:val="single" w:color="auto" w:sz="4"/><w:insideH w:val="single" w:color="auto" w:sz="4"/><w:insideV w:val="single" w:color="auto" w:sz="4"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="100"/><w:gridCol w:w="100"/><w:gridCol w:w="100"/></w:tblGrid><w:tr><w:trPr><w:tblHeader/></w:trPr><w:tc><w:p><w:r><w:t xml:space="preserve">Name</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">Role</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">Active</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:p><w:r><w:t xml:space="preserve">Ada</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">Engineer</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">✅</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:p><w:r><w:t xml:space="preserve">Grace</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">Scientist</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t xml:space="preserve">❌</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Release Checklist</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">[x] </w:t></w:r><w:r><w:t xml:space="preserve">Write the characterization suite</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">[ ] </w:t></w:r><w:r><w:t xml:space="preserve">Get sign-off from the owner</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">[x] </w:t></w:r><w:r><w:t xml:space="preserve">Nested done item</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">[ ] </w:t></w:r><w:r><w:t xml:space="preserve">Nested todo item</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Notes</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">This is </w:t></w:r><w:r><w:rPr><w:strike/></w:rPr><w:t xml:space="preserve">struck through</w:t></w:r><w:r><w:t xml:space="preserve"> text.</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">Visit </w:t></w:r><w:hyperlink w:history="1" r:id="RID"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr></w:r></w:hyperlink><w:r><w:t xml:space="preserve"> for details, or email </w:t></w:r><w:hyperlink w:history="1" r:id="RID"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr></w:r></w:hyperlink><w:r><w:t xml:space="preserve"> with questions.</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Example</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:spacing w:after="120" w:before="120"/><w:ind w:left="720"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/><w:shd w:fill="F0F0F0"/></w:rPr><w:t xml:space="preserve">function greet(name: string): string {
  return \`Hello, \${name}!\`;
}</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">Inline code like </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:shd w:fill="EFEFEF"/></w:rPr><w:t xml:space="preserve">const x = 1;</w:t></w:r><w:r><w:t xml:space="preserve"> should stay inline.</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Math</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">Inline math: $E = mc^2$ is Einstein&apos;s mass-energy equivalence.</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">Block math:</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">$$
\\int_0^\\infty e^{-x^2} </w:t></w:r><w:r><w:t xml:space="preserve">\\,</w:t></w:r><w:r><w:t xml:space="preserve"> dx = \\frac{\\sqrt{\\pi}}{2}
$$</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Flow</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:spacing w:after="120" w:before="120"/><w:ind w:left="720"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Courier New" w:cs="Courier New" w:eastAsia="Courier New" w:hAnsi="Courier New"/><w:sz w:val="18"/><w:szCs w:val="18"/><w:shd w:fill="F0F0F0"/></w:rPr><w:t xml:space="preserve">graph TD;
  A[Start] --&gt; B{Decision};
  B --&gt;|Yes| C[Do thing];
  B --&gt;|No| D[Skip];</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Nested Lists</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">First</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Second</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Second.a</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Second.b</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">bullet in ordered</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Third</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Alpha</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Beta</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Beta.1</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="1"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Beta.2</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Beta.2.i</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="2"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Beta.2.ii</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t xml:space="preserve">Gamma</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Quoting</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="IntenseQuote"/><w:ind w:left="720"/></w:pPr><w:r><w:t xml:space="preserve">A simple blockquote.</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="IntenseQuote"/><w:ind w:left="720"/></w:pPr><w:r><w:t xml:space="preserve">A nested blockquote inside the first.</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="IntenseQuote"/><w:ind w:left="720"/></w:pPr><w:r><w:t xml:space="preserve">Back to the first level.</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Embedded HTML</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">Note: this is raw HTML embedded in markdown.</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">Some text with an inline </w:t></w:r><w:r><w:t xml:space="preserve">red span</w:t></w:r><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p><w:p/><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Links and Images</w:t></w:r></w:p><w:p/><w:p><w:hyperlink w:history="1" r:id="RID"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr></w:r></w:hyperlink></w:p><w:p/><w:p><w:r><w:rPr><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">[image: Atlas logo]</w:t></w:r></w:p><w:p/><w:p><w:r><w:t xml:space="preserve">A reference-style </w:t></w:r><w:hyperlink w:history="1" r:id="RID"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr></w:r></w:hyperlink><w:r><w:t xml:space="preserve"> and image </w:t></w:r><w:r><w:rPr><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">[image: alt text]</w:t></w:r><w:r><w:t xm