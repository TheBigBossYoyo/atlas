<h6 id="heading-six-with-strikethrough">Heading <del>Six</del> with Strikethrough</h6>
<h2 id="team-roster">Team Roster</h2>




















<table><thead><tr><th>Name</th><th>Role</th><th style="text-align: center;">Active</th></tr></thead><tbody><tr><td>Ada</td><td>Engineer</td><td style="text-align: center;">✅</td></tr><tr><td>Grace</td><td>Scientist</td><td style="text-align: center;">❌</td></tr></tbody></table>
<h2 id="release-checklist">Release Checklist</h2>
<ul class="contains-task-list">
<li class="task-list-item"><input disabled="" type="checkbox" checked=""> Write the characterization suite</li>
<li class="task-list-item"><input disabled="" type="checkbox"> Get sign-off from the owner
<ul class="contains-task-list">
<li class="task-list-item"><input disabled="" type="checkbox" checked=""> Nested done item</li>
