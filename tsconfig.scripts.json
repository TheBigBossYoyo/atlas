{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode — matches tsconfig.app.json, because
       generate-extension-manifest.mjs imports src/formats/extensionManifest.ts
       directly (Node 24 native TS type-stripping) and that file is only valid
       under bundler-style resolution. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Plain ESM JS with JSDoc, same treatment as tsconfig.electron.json's CJS */
    "allowJs": true,
    "checkJs": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts/**/*.mjs", "tests/e2e/fixtures/*.mjs"]
}
