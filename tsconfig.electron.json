{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "node16",
    "types": ["node"],
    "skipLibCheck": true,

    /* CommonJS main process, plain JS with JSDoc */
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["electron/**/*.cjs"]
}
